# Maestro Linux sandbox çalıştırıcı imajı (RUNNER_IMAGE_LINUX).
#
# Bu konteynerde AJAN ÇALIŞMAZ: ajan (Claude CLI) worker'ın konağında koşar ve
# koşunun klonunu düzenler. Konteyner o klonu bağlı hacimden görür ve şunları
# yapar: `git status/diff` (M52 korumalı yol denetimi), kurulumun doğrulama
# komutları (derleme/test, `.maestro.yaml` ya da koşu bağlamı) ve
# doğrulayıcının komutları. Bu yüzden içinde derleme araçları var, model yok.
#
# Kök dosya sistemi salt-okunur, yazılabilir alan /workspace ve /tmp (noexec).
# Varsayılan kullanıcı 10001; bağlı çalışma alanında RUNNER_SANDBOX_USER klonun
# sahibiyle eşleşmeli (ör. 1000:1000).
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    MAVEN_OPTS="-Dmaven.repo.local=/workspace/.m2/repository"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates curl openssh-client \
      openjdk-17-jdk-headless maven \
      python3 make g++ \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable \
 && groupadd -g 10001 sandbox && useradd -u 10001 -g 10001 -m -s /bin/sh sandbox \
 && mkdir -p /workspace && chown 10001:10001 /workspace \
 && git config --system safe.directory '*'

WORKDIR /workspace
USER 10001:10001
CMD ["/bin/sh"]
