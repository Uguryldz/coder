}

/// StepKind
enum StepKindE {
  system
  ai
  human_gate
  human_wait
  auto_gate
}

/// ApplicationRecord.createdVia (M100)
enum CreatedViaE {
  onboarding
  import
}

// ---------------------------------------------------------------------------
// Workflow
// ---------------------------------------------------------------------------

model WorkflowRun {
  id        String     @id @db.VarChar(128)
  ticketKey String     @db.VarChar(64)
  appId     String?    @db.VarChar(64)
  mode      WorkModeE
  risk      RiskTierE?
  dataClass DataClassE
  /// StepId — kept as text: "2b"/"3o" are not legal Prisma enum identifiers,
  /// so contracts' StepId enum stays the single validator (M104 titles too).
  step      String     @db.VarChar(8)
  status    RunStatus
  matchJson Json? // MatchResult (M99)
  startedAt DateTime   @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  /// ---------------------------------------------------------------------
  /// Run context (Dalga 5). An activity receives a `TicketKey` and nothing
  /// else — the workflow may not carry mutable business state through its
  /// arguments — so every fact about the run is read back from this row
  /// (`RunContextStore`, packages/workflows/src/impl/deps.ts).
  ///
  /// The columns are NOT NULL with defaults rather than nullable: a run whose
  /// branch is NULL is a run the engineering turn cannot push, and "" is a
  /// value the store can refuse loudly. Nullable columns would push that
  /// check to every reader, and one of them would forget.
  /// ---------------------------------------------------------------------
  /// Locale — text, because contracts' Locale is the validator (M104).
  locale           String  @default("tr") @db.VarChar(8)
  /// Prompt-variant the run is pinned to (M38).
  variantId        String  @default("") @db.VarChar(64)
  /// Analysis template pinned at run start (M83).
  templateVersion  String  @default("") @db.VarChar(64)
  workspacePath    String  @default("")
  /// False after an M65 archive — the clone is gone, the context is not.
  workspacePresent Boolean @default(false)
  /// The repo's ADDITIONS to the M52 deny-list, from `.maestro.yaml` (M71).
  protectedPathsJson Json? // string[]
  /// The repo's own lint/build/test commands (`.maestro.yaml`, M71).
  verificationJson   Json? // CommandSpec[]
  branch           String  @default("") @db.VarChar(255)
  targetBranch     String  @default("") @db.VarChar(255)
  prId             Int?
  /// Resume token of the live agent session (M30); NULL before the first turn.
  resumeToken      String?

  stepEvents  StepEvent[]
  gates       Gate[]
  strikes     StrikeCounter[]
  journal     JournalEntry[]
  application Application?   @relation(fields: [appId], references: [appId], onDelete: Restrict, onUpdate: Cascade)

  @@index([status])
  @@index([appId, status])
  @@index([updatedAt]) // Studio "recent runs" list ordering
  /// One ticket may legitimately be re-run (kill switch, handover, a second
  /// `/ai-start`), so the key is indexed, not unique. "At most one LIVE run per
  /// ticket" is a partial unique index Prisma cannot express — it lives in
  /// prisma/migrations/0002_append_only_and_guards/migration.sql.
  @@index([ticketKey])
}

model StepEvent {
  id       BigInt    @id @default(autoincrement())
  runId    String    @db.VarChar(128)
  step     String    @db.VarChar(8)
  kind     StepKindE
  at       DateTime  @db.Timestamptz(3)
  dataJson Json?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([runId, at])
}

model JournalEntry {
  runId    String        @db.VarChar(128)
  seq      Int
  at       DateTime      @db.Timestamptz(3)
  actor    JournalActorE
  kind     JournalKindE
  title    String
  detail   String        @default("")
  costJson Json?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([runId, seq]) // append-only; no updates by convention (M30)
}

/// One approval gate, and the escalation ladder's anchor (M88).
///
/// `openedAt` is that anchor: the ladder's thresholds are measured from it, so
/// re-opening an already-open gate must NOT move it — `GateStore.open` is
/// idempotent and the primary key below is what makes that enforceable rather
/// than merely intended. Two workers racing the same signal get one row and
/// one ladder, not two.
///
/// `firedStepIds` is the ladder's memory: a step whose id is in this array is
/// never sent again. It is an array column rather than a child table because
/// it is only ever read whole, and because appending under a single UPDATE is
/// what keeps a concurrent reminder from losing the other's write.
model Gate {
  runId    String    @db.VarChar(128)
  /// StepId — text, same reason as `WorkflowRun.step`.
  step     String    @db.VarChar(8)
  /// The group that OWNS the gate; only its members may close it (M32/M51).
  ownerGroup String  @db.VarChar(128)
  openedAt DateTime  @db.Timestamptz(3)
  /// Ladder steps already sent; the ladder never fires the same one twice.
  firedStepIds String[]
  /// NULL while the gate is open. A closed gate is never re-opened — a second
  /// decision on the same step is a new run's business (M51).
  closedAt DateTime? @db.Timestamptz(3)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([runId, step])
  @@index([closedAt]) // "which gates are still open" — the ladder's sweep
}

/// Three-strike counters (M54), made durable.
///
/// The stuck-protection rule is "the same failure three times → drop to
/// ai-assist and hand the ticket to a human". Counting that in memory works
/// for one worker that never stops, and neither holds: a worker is redeployed
/// mid-run, and Temporal can retry an activity on a DIFFERENT worker from the
/// one that recorded strike two. Both reset the count to zero, so "three
/// rejections at the same gate" never arrives and the run retries the same
/// failing turn forever — the exact stuck loop M54 exists to break.
///
/// Keyed by `(runId, scope, ref)` because different scopes never share a
/// count: a green build does not absolve three rejections at the Tech Lead
/// gate, so only the key that succeeded is ever cleared.
model StrikeCounter {
  runId String @db.VarChar(128)
  /// gate | ci | agent — see `STRIKE_SCOPES`.
  scope String @db.VarChar(16)
  /// Gate id ("5"), CI-error fingerprint, or the agent failure reason.
  ref   String @db.VarChar(256)

  count Int
  /// When this counter opened; kept across a restart so the handover note can
  /// say how long the run has been stuck rather than when it was last read.
  firstAt DateTime @db.Timestamptz(3)
  lastAt  DateTime @db.Timestamptz(3)
  /// Most recent reasons, oldest first; the handover note quotes them.
  reasons String[]

  /// Restrict, like every other relation in this schema (M30/M56): a run's
  /// rows are evidence of how it was handled, and a cascade would let a
  /// deletion elsewhere quietly take the record of a handover with it. The
  /// counters are cleared explicitly, by the ledger, when they stop applying.
  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([runId, scope, ref])
  /// "which runs are stuck" — the operator's view and the ledger's hydrate.
  @@index([runId])
}

/// Table-backed idempotency (M33).
///
/// Temporal retries an activity that failed halfway, so "post the Jira comment,
/// then append the audit record" would run the comment twice unless something
/// remembers across processes. `InMemoryIdempotency` remembers within ONE
/// worker; this table is what makes the guarantee survive a second worker and
/// a restart.
///
/// The primary key is the whole mechanism: two workers racing the same key
/// both INSERT, exactly one wins, and the loser waits for the winner's row
/// rather than running the effect a second time.
model IdempotencyKey {
  key       String   @id @db.VarChar(512)
  /// `done` rows carry the first result, replayed verbatim on every retry.
  /// A row is inserted `running` first: the claim has to be visible to the
  /// racing worker BEFORE the effect runs, or both would run it.
  state     String   @db.VarChar(16) // running | done
  /// The first result, JSON-encoded. NULL while `running`, and legitimately
  /// NULL for a `done` effect that returned `undefined`.
  resultJson Json?
  claimedAt DateTime @db.Timestamptz(3)
  /// Set when the effect completed; NULL while `running`.
  completedAt DateTime? @db.Timestamptz(3)

  @@index([claimedAt]) // retention sweep: finished keys are not kept forever
}

/// Publish receipts, keyed by document (M47/M75).
///
/// `@maestro/publish` remembers "I already posted this analysis as comment
/// 4711 with hash abc" so a republish EDITS that comment instead of adding a
/// second one. `InMemoryPublishState` loses that on restart, and the next
/// publish then posts a duplicate to a bank's ticket — which is why the
/// composition root refused to build the publish deps without this table.
///
/// The value is opaque text: each driver stores its own shape (a Confluence
/// page id, a JSON `{commentId, hash}`), and giving them columns here would
/// make this table know about drivers it must not know about.
model PublishState {
  key   String @id @db.VarChar(512)
  value String

  updatedAt DateTime @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Application registry (M100)
// ---------------------------------------------------------------------------

model Application {
  appId              String      @id @db.VarChar(64)
  displayName        String
  adoProject         String
  adoRepo            String
  /// PlatformProfile — text because "linux-node" & co. are not legal Prisma
  /// enum identifiers; contracts' PlatformProfile is the validator.
  platform           String      @db.VarChar(32)
  jiraComponent      String?     @db.VarChar(128)
  maestroYamlPresent Boolean     @default(false)
  createdVia         CreatedViaE

  runs      WorkflowRun[]
  repoCards RepoCard[]
}

model RepoCard {
  appId            String   @db.VarChar(64)
  version          Int
  modulesJson      Json // RepoCardModule[]
  generatedFromSha String   @db.VarChar(40)
  updatedAt        DateTime @db.Timestamptz(3)

  application Application @relation(fields: [appId], references: [appId], onDelete: Restrict, onUpdate: Cascade)

  @@id([appId, version])
}

// ---------------------------------------------------------------------------
// Jira binding & routing (M102/M99)
// ---------------------------------------------------------------------------

model JiraProjectBinding {
  projectKey       String        @id @db.VarChar(32)
  trigger          TriggerModeE
  triggerLabel     String        @default("maestro") @db.VarChar(64)
  defaultsJson     Json // { mode, dataClass }
  state            BindingStateE
  dryRunSampleSize Int           @default(20)
  lastDryRunAt     DateTime?     @db.Timestamptz(3)
  version          Int           @default(1)
}

model RoutingRule {
  ruleId        String  @id @db.VarChar(64)
  /// NULL = org-wide rule, which the contract spells `"*"`
  /// (`RoutingRule.projectKey = ProjectKey.or("*")`). `src/routing-map.ts` owns
  /// the `"*" <-> NULL` translation, so no caller invents its own sentinel.
  ///
  /// Deliberately NOT a foreign key to `JiraProjectBinding`: an org-wide guard
  /// rule has no binding to point at, and M102's `unbind` keeps a project's
  /// history after its binding row is gone.
  projectKey    String? @db.VarChar(32)
  conditionJson Json // RuleCondition
  effectJson    Json // { appId?, mode?, dataClass? }
  priority      Int

  @@index([projectKey, priority])
}

// ---------------------------------------------------------------------------
// Parameters (M71) — versioned + audited operational settings
// ---------------------------------------------------------------------------

model Param {
  key     String      @id @db.VarChar(64)
  scope   ParamScopeE
  type    ParamTypeE
  guarded Boolean
  defJson Json // ParamDefinition remainder (enumValues, descriptionKey, defaultValue)

  versions ParamVersion[]
}

model ParamVersion {
  key        String   @db.VarChar(64)
  scopeRef   String   @default("") @db.VarChar(64) // "" = global scope
  version    Int
  valueJson  Json
  /// Denormalized copy of `Param.guarded` as it stood when the version was
  /// written. It exists so the database itself can enforce four-eyes: a CHECK
  /// constraint refuses a guarded version with no approver (M71/M78). A
  /// sub-query cannot appear in a CHECK, hence the copy. `writeParamVersion()`
  /// is the only writer and reads the flag from `Param`.
  guarded    Boolean
  changedBy  String
  approvedBy String? // NOT NULL whenever `guarded` — CHECK in migration 0002
  at         DateTime @db.Timestamptz(3)

  param Param @relation(fields: [key], references: [key], onDelete: Restrict, onUpdate: Cascade)

  @@id([key, scopeRef, version])
}

// ---------------------------------------------------------------------------
// Audit (M33) — hash chain, append-only
// ---------------------------------------------------------------------------

model AuditLog {
  seq      BigInt       @id // assigned by packages/audit under a chain lock
  at       DateTime     @db.Timestamptz(3)
  actor    String
  action   AuditActionE
  subject  String       @db.VarChar(128)
  /// Unique: two rows may never share a predecessor, so the chain cannot fork
  /// and there is at most one genesis row (M33). The writer's lock orders
  /// appends inside one process; this index is what stops a second process.
  prevHash String       @unique @db.VarChar(64) // sha256 hex | "genesis"
  hash     String       @unique @db.VarChar(64)
  metaJson Json?

  @@index([at])
  @@index([action])
  @@index([subject]) // evidence package collects one ticket's chain
}

// ---------------------------------------------------------------------------
// LLM gateway (M16/M55)
// ---------------------------------------------------------------------------

model LlmCall {
  id        BigInt     @id @default(autoincrement())
  at        DateTime   @db.Timestamptz(3)
  runId     String?    @db.VarChar(128) // no FK: calls may outlive/precede a run row
  role      LlmRoleE
  variantId String     @db.VarChar(64)
  /// LlmDriverId — text because "anthropic-direct"/"claude-sub" are not legal
  /// Prisma enum identifiers; contracts' LlmDriverId is the validator.
  driver    String     @db.VarChar(32)
  model     String     @db.VarChar(128)
  tokensIn  Int
  tokensOut Int
  cachePct  Float?
  usd       Decimal?   @db.Decimal(12, 6) // null for subscription drivers (M55)
  dataClass DataClassE

  @@index([runId])
  @@index([at])
  @@index([driver, at]) // per-driver cost/quota reporting
}

model SubscriptionAccount {
  accountId   String             @id @db.VarChar(64)
  /// SubscriptionDriverId — text (dashes are not legal enum identifiers).
  driver      String             @db.VarChar(32)
  state       SubscriptionStateE
  windowsJson Json // QuotaWindow[] (M55)
  lastUsedAt  DateTime?          @db.Timestamptz(3)

  @@index([driver, state]) // quota-aware pool picker
}

model Variant {
  id   String   @id @db.VarChar(64)
  role LlmRoleE
  name String

  versions VariantVersion[]
}

model VariantVersion {
  variantId  String   @db.VarChar(64)
  version    Int
  model      String   @db.VarChar(128)
  configJson Json
  evalScore  Float?
  createdAt  DateTime @db.Timestamptz(3)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([variantId, version])
}

// ---------------------------------------------------------------------------
// Knowledge & evidence
// ---------------------------------------------------------------------------

/// Versioned by (id, version): M83 pins a flow to the template version it
/// started with, so a version may never be overwritten in place. Same pattern
/// as RepoCard.
model KnowledgeDoc {
  id         String   @db.VarChar(64)
  kind       String   @db.VarChar(32) // template | example_analysis | standard | app_intro | policy
  title      String
  version    Int
  contentRef String // StoragePort key
  updatedAt  DateTime @db.Timestamptz(3)

  @@id([id, version])
  @@index([kind])
}

model EvidencePackageRow {
  runId        String   @id @db.VarChar(128)
  /// Indexed, not unique: a re-run produces a second package, and refusing to
  /// store it would mean losing evidence (M34/M56).
  ticketKey    String   @db.VarChar(64)
  createdAt    DateTime @db.Timestamptz(3)
  manifestJson Json // EvidencePackage manifest
  storageKey   String

  @@index([createdAt]) // 10-year retention sweeps (M56)
  @@index([ticketKey])
}

// MVP local users (M8); AD/LDAP arrives in Aşama 2.
model User {
  id           String  @id @db.VarChar(64)
  email        String  @unique @db.VarChar(320)
  displayName  String
  passwordHash String
  groupsJson   Json // string[]
  active       Boolean @default(true)
}
