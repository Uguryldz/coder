enum AuditActionE {
  RUN_STARTED
  GATE_OPEN
  GATE_APPROVE
  GATE_REJECT
  CLARIFICATION_ASKED
  CLARIFICATION_ANSWERED
  PII_MASKED
  SECURITY_SCAN_PASS
  SECURITY_SCAN_FAIL
  SANDBOX_CREATE
  SANDBOX_DESTROY
  TEST_RUN_COMPLETE
  CI_RESULT
  PR_OPENED
  PR_MERGED
  MODE_CHANGED
  HANDOVER
