// Maestro core schema (Wave 1, `db` packet).
//
// Conventions — rationale in packages/db/RAPOR.md:
//  · Enum values mirror @maestro/contracts 1:1. A Prisma enum is only used
//    where every contract option is also a legal Prisma identifier, so the
//    generated TypeScript union equals the contract union (no @map aliases,
//    no translation layer for callers).
//  · Every DateTime is timestamptz(3): the platform is audit-grade and the
//    contracts carry offset-aware ISO strings (M33/M56).
//  · Relations are onDelete: Restrict — runs, journals, audit rows and
//    evidence are retained, never cascaded away (M30/M56). Key updates
//    cascade, since an id rename is a rename, not a deletion.
//  · Money is Decimal, never Float (M55 cost accounting).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — mirrors of @maestro/contracts (verified by test/schema-enums.test.ts)
// ---------------------------------------------------------------------------

/// WorkflowRunStatus
enum RunStatus {
  running
  gate
  queued
  fail
  handover
  done
  cancelled
}

/// WorkMode (M46)
enum WorkModeE {
  full_auto
  ai_assist
  human_lead
  human_only
}

/// RiskTier (M51)
enum RiskTierE {
  dusuk
  orta
  kritik
}

/// DataClass (M18)
enum DataClassE {
  acik
  dahili
  gizli
}

/// BindingState (M102)
enum BindingStateE {
  draft
  dry_run
  active
  paused
  unbound
}

/// TriggerMode (M48a/M102)
enum TriggerModeE {
  auto
  label
  command
}

/// ParamScope (M71)
enum ParamScopeE {
  global
  project
  application
}

/// ParamType (M71)
enum ParamTypeE {
  string
  number
  boolean
  enum
  json
}

/// JournalActor (M30)
enum JournalActorE {
  ai
  human
  system
}

/// JournalKind (M30)
enum JournalKindE {
  intake
  clarification
  discovery
  analysis
  gate
  engineering
  scan
  review
  test_design
  test_review
  test_run
  ci
  pr
  handover
  pii
  quota
  closure
  other
}

/// AuditAction (M33)
enum AuditActionE {
  RUN_STARTED
  GATE_OPEN
  GATE_APPROVE
  GATE_REJECT
  CLARIFICATION_ASKED
  CLARIFICATION_ANSWERED
  PII_MASKED
  SECURITY_SCAN_PASS
  SECURITY_SCAN_FAIL
  SANDBOX_CREATE
  SANDBOX_DESTROY
  TEST_RUN_COMPLETE
  CI_RESULT
  PR_OPENED
  PR_MERGED
  MODE_CHANGED
  HANDOVER
  ASSIGN_APP
  PARAM_CHANGED
  BINDING_CHANGED
  KILL_SWITCH
  MCP_TOOL_CALL
  QUOTA_WARN
  RETENTION_ARCHIVE
  RESTORE_DRILL
  RUN_CLOSED
}

/// LlmRole (M17/M43)
enum LlmRoleE {
  intake
  analyst
  engineer
  dev_reviewer
  test_designer
  test_reviewer
  test_engineer
}

/// SubscriptionAccountState (M55)
enum SubscriptionStateE {
  ready
  cooling
  exhausted
  disabled
}

/// StepKind
enum StepKindE {
  system
  ai
  human_gate
  human_wait
  auto_gate
}

/// ApplicationRecord.createdVia (M100)
enum CreatedViaE {
  onboarding
  import
}

// ---------------------------------------------------------------------------
// Workflow
// ---------------------------------------------------------------------------

model WorkflowRun {
  id        String     @id @db.VarChar(128)
  ticketKey String     @db.VarChar(64)
  appId     String?    @db.VarChar(64)
  mode      WorkModeE
  risk      RiskTierE?
  dataClass DataClassE
  /// StepId — kept as text: "2b"/"3o" are not legal Prisma enum identifiers,
  /// so contracts' StepId enum stays the single validator (M104 titles too).
  step      String     @db.VarChar(8)
  status    RunStatus
  matchJson Json? // MatchResult (M99)
  startedAt DateTime   @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  stepEvents  StepEvent[]
  journal     JournalEntry[]
  application Application?   @relation(fields: [appId], references: [appId], onDelete: Restrict, onUpdate: Cascade)

  @@index([status])
  @@index([appId, status])
  @@index([updatedAt]) // Studio "recent runs" list ordering
  /// One ticket may legitimately be re-run (kill switch, handover, a second
  /// `/ai-start`), so the key is indexed, not unique. "At most one LIVE run per
  /// ticket" is a partial unique index Prisma cannot express — it lives in
  /// prisma/migrations/0002_append_only_and_guards/migration.sql.
  @@index([ticketKey])
}

model StepEvent {
  id       BigInt    @id @default(autoincrement())
  runId    String    @db.VarChar(128)
  step     String    @db.VarChar(8)
  kind     StepKindE
  at       DateTime  @db.Timestamptz(3)
  dataJson Json?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([runId, at])
}

model JournalEntry {
  runId    String        @db.VarChar(128)
  seq      Int
  at       DateTime      @db.Timestamptz(3)
  actor    JournalActorE
  kind     JournalKindE
  title    String
  detail   String        @default("")
  costJson Json?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([runId, seq]) // append-only; no updates by convention (M30)
}

// ---------------------------------------------------------------------------
// Application registry (M100)
// ---------------------------------------------------------------------------

model Application {
  appId              String      @id @db.VarChar(64)
  displayName        String
  adoProject         String
  adoRepo            String
  /// PlatformProfile — text because "linux-node" & co. are not legal Prisma
  /// enum identifiers; contracts' PlatformProfile is the validator.
  platform           String      @db.VarChar(32)
  jiraComponent      String?     @db.VarChar(128)
  maestroYamlPresent Boolean     @default(false)
  createdVia         CreatedViaE

  runs      WorkflowRun[]
  repoCards RepoCard[]
}

model RepoCard {
  appId            String   @db.VarChar(64)
  version          Int
  modulesJson      Json // RepoCardModule[]
  generatedFromSha String   @db.VarChar(40)
  updatedAt        DateTime @db.Timestamptz(3)

  application Application @relation(fields: [appId], references: [appId], onDelete: Restrict, onUpdate: Cascade)

  @@id([appId, version])
}

// ---------------------------------------------------------------------------
// Jira binding & routing (M102/M99)
// ---------------------------------------------------------------------------

model JiraProjectBinding {
  projectKey       String        @id @db.VarChar(32)
  trigger          TriggerModeE
  triggerLabel     String        @default("maestro") @db.VarChar(64)
  defaultsJson     Json // { mode, dataClass }
  state            BindingStateE
  dryRunSampleSize Int           @default(20)
  lastDryRunAt     DateTime?     @db.Timestamptz(3)
  version          Int           @default(1)
}

model RoutingRule {
  ruleId        String  @id @db.VarChar(64)
  /// NULL = org-wide rule, which the contract spells `"*"`
  /// (`RoutingRule.projectKey = ProjectKey.or("*")`). `src/routing-map.ts` owns
  /// the `"*" <-> NULL` translation, so no caller invents its own sentinel.
  ///
  /// Deliberately NOT a foreign key to `JiraProjectBinding`: an org-wide guard
  /// rule has no binding to point at, and M102's `unbind` keeps a project's
  /// history after its binding row is gone.
  projectKey    String? @db.VarChar(32)
  conditionJson Json // RuleCondition
  effectJson    Json // { appId?, mode?, dataClass? }
  priority      Int

  @@index([projectKey, priority])
}

// ---------------------------------------------------------------------------
// Parameters (M71) — versioned + audited operational settings
// ---------------------------------------------------------------------------

model Param {
  key     String      @id @db.VarChar(64)
  scope   ParamScopeE
  type    ParamTypeE
  guarded Boolean
  defJson Json // ParamDefinition remainder (enumValues, descriptionKey, defaultValue)

  versions ParamVersion[]
}

model ParamVersion {
  key        String   @db.VarChar(64)
  scopeRef   String   @default("") @db.VarChar(64) // "" = global scope
  version    Int
  valueJson  Json
  /// Denormalized copy of `Param.guarded` as it stood when the version was
  /// written. It exists so the database itself can enforce four-eyes: a CHECK
  /// constraint refuses a guarded version with no approver (M71/M78). A
  /// sub-query cannot appear in a CHECK, hence the copy. `writeParamVersion()`
  /// is the only writer and reads the flag from `Param`.
  guarded    Boolean
  changedBy  String
  approvedBy String? // NOT NULL whenever `guarded` — CHECK in migration 0002
  at         DateTime @db.Timestamptz(3)

  param Param @relation(fields: [key], references: [key], onDelete: Restrict, onUpdate: Cascade)

  @@id([key, scopeRef, version])
}

// ---------------------------------------------------------------------------
// Audit (M33) — hash chain, append-only
// ---------------------------------------------------------------------------

model AuditLog {
  seq      BigInt       @id // assigned by packages/audit under a chain lock
  at       DateTime     @db.Timestamptz(3)
  actor    String
  action   AuditActionE
  subject  String       @db.VarChar(128)
  /// Unique: two rows may never share a predecessor, so the chain cannot fork
  /// and there is at most one genesis row (M33). The writer's lock orders
  /// appends inside one process; this index is what stops a second process.
  prevHash String       @unique @db.VarChar(64) // sha256 hex | "genesis"
  hash     String       @unique @db.VarChar(64)
  metaJson Json?

  @@index([at])
  @@index([action])
  @@index([subject]) // evidence package collects one ticket's chain
}

// ---------------------------------------------------------------------------
// LLM gateway (M16/M55)
// ---------------------------------------------------------------------------

model LlmCall {
  id        BigInt     @id @default(autoincrement())
  at        DateTime   @db.Timestamptz(3)
  runId     String?    @db.VarChar(128) // no FK: calls may outlive/precede a run row
  role      LlmRoleE
  variantId String     @db.VarChar(64)
  /// LlmDriverId — text because "anthropic-direct"/"claude-sub" are not legal
  /// Prisma enum identifiers; contracts' LlmDriverId is the validator.
  driver    String     @db.VarChar(32)
  model     String     @db.VarChar(128)
  tokensIn  Int
  tokensOut Int
  cachePct  Float?
  usd       Decimal?   @db.Decimal(12, 6) // null for subscription drivers (M55)
  dataClass DataClassE

  @@index([runId])
  @@index([at])
  @@index([driver, at]) // per-driver cost/quota reporting
}

model SubscriptionAccount {
  accountId   String             @id @db.VarChar(64)
  /// SubscriptionDriverId — text (dashes are not legal enum identifiers).
  driver      String             @db.VarChar(32)
  state       SubscriptionStateE
  windowsJson Json // QuotaWindow[] (M55)
  lastUsedAt  DateTime?          @db.Timestamptz(3)

  @@index([driver, state]) // quota-aware pool picker
}

model Variant {
  id   String   @id @db.VarChar(64)
  role LlmRoleE
  name String

  versions VariantVersion[]
}

model VariantVersion {
  variantId  String   @db.VarChar(64)
  version    Int
  model      String   @db.VarChar(128)
  configJson Json
  evalScore  Float?
  createdAt  DateTime @db.Timestamptz(3)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([variantId, version])
}

// ---------------------------------------------------------------------------
// Knowledge & evidence
// ---------------------------------------------------------------------------

/// Versioned by (id, version): M83 pins a flow to the template version it
/// started with, so a version may never be overwritten in place. Same pattern
/// as RepoCard.
model KnowledgeDoc {
  id         String   @db.VarChar(64)
  kind       String   @db.VarChar(32) // template | example_analysis | standard | app_intro | policy
  title      String
  version    Int
  contentRef String // StoragePort key
  updatedAt  DateTime @db.Timestamptz(3)

  @@id([id, version])
  @@index([kind])
}

model EvidencePackageRow {
  runId        String   @id @db.VarChar(128)
  /// Indexed, not unique: a re-run produces a second package, and refusing to
  /// store it would mean losing evidence (M34/M56).
  ticketKey    String   @db.VarChar(64)
  createdAt    DateTime @db.Timestamptz(3)
  manifestJson Json // EvidencePackage manifest
  storageKey   String

  @@index([createdAt]) // 10-year retention sweeps (M56)
  @@index([ticketKey])
}

// MVP local users (M8); AD/LDAP arrives in Aşama 2.
model User {
  id           String  @id @db.VarChar(64)
  email        String  @unique @db.VarChar(320)
  displayName  String
  passwordHash String
  groupsJson   Json // string[]
  active       Boolean @default(true)
}
