# ===== DATABASE (uinfra harici Postgres) =====
# Docker network içinden: host = postgres (uinfra-postgres container)
# Host'tan (dev-host mode): gerekirse uinfra-postgres'in exposed port'u
DATABASE_URL="postgresql://sa:SaPass..123@postgres:5432/orkestra?schema=public"

# Temporal cluster state — aynı Postgres, `temporal` ve `temporal_visibility` DB'leri
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_USER="sa"
POSTGRES_PASSWORD="SaPass..123"

# ===== REDIS (uinfra harici Redis) =====
# DB 1 kullanıyoruz — uinfra'daki diğer projelerle çakışmasın
REDIS_URL="redis://redis:6379/1"

# ===== MINIO / S3 =====
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="orkestra"
S3_SECRET_KEY="orkestra-dev-secret"
S3_BUCKET="orkestra"
S3_REGION="us-east-1"

# ===== VAULT =====
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN="orkestra-dev-root"
VAULT_MOUNT="secret"

# ===== TEMPORAL =====
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="orkestra"

# ===== CLAUDE / ANTHROPIC =====
# Leave empty to use mock LLM for development/testing
ANTHROPIC_API_KEY=""
LLM_MODE="mock"   # mock | real
CLAUDE_MODEL_OPUS="claude-opus-4-7"
CLAUDE_MODEL_SONNET="claude-sonnet-4-6"
CLAUDE_MODEL_HAIKU="claude-haiku-4-5-20251001"

# ===== JIRA =====
JIRA_BASE_URL="http://localhost:8080"          # dockerized Jira for tests
JIRA_USERNAME=""
JIRA_API_TOKEN=""
JIRA_WEBHOOK_SECRET="change-me-in-prod"

# ===== BITBUCKET =====
BITBUCKET_BASE_URL="http://localhost:7990"     # dockerized Bitbucket for tests
BITBUCKET_USERNAME=""
BITBUCKET_APP_PASSWORD=""
BITBUCKET_WEBHOOK_SECRET="change-me-in-prod"

# ===== SLACK =====
SLACK_WEBHOOK_URL=""

# ===== TESTRAIL / XRAY =====
TESTRAIL_BASE_URL=""
TESTRAIL_USER=""
TESTRAIL_API_KEY=""

# ===== APP =====
# Studio 7000 (kullanıcıya görünür), API 7001 (webhook endpoint)
API_PORT=7001
STUDIO_PORT=7000

# Prod docker compose host port mapping'leri:
STUDIO_HOST_PORT=7000
API_HOST_PORT=7001
NODE_ENV="development"
LOG_LEVEL="info"
CORRELATION_ID_HEADER="x-correlation-id"

# ===== AUTH =====
NEXTAUTH_URL="http://localhost:7000"
NEXTAUTH_SECRET="change-me-in-prod-to-a-long-random-string"

# Reverse proxy arkasındaysa dış URL'ler (boşsa localhost fallback):
# PUBLIC_URL="http://orkestra.company.local"
# PUBLIC_API_URL="http://orkestra.company.local:7001"

# ===== COST / RATE LIMITS =====
COST_BUDGET_PER_WORKFLOW_USD="5.00"
ANTHROPIC_RPM_LIMIT="4000"
ANTHROPIC_TPM_INPUT_LIMIT="2000000"
SANDBOX_MAX_CONCURRENT="4"    # overridden based on CPU in production
